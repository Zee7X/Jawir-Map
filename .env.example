# Copy to .env.local for local development. On Vercel, set these under Project → Settings → Environment Variables.

# TiDB Cloud Serverless connection string (must start with mysql://).
# Leave empty locally to use the in-memory demo pins; production must set it, or pins vanish on every cold start.
DATABASE_URL=mysql://user:password@gateway01.region.tidbcloud.com:4000/dbname?ssl={"rejectUnauthorized":true}

# Secret salt for the SHA-256 device and IP hashes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse this example value, and never change it after launch (existing device hashes would stop matching).
HASH_SALT=replace-with-a-long-random-string

# Public URL used for canonical links and share previews.
NEXT_PUBLIC_SITE_URL=https://jawirmap.lumelo.my.id

# Admin page at /admin (moderation of reported pins). At least 12 characters; leave unset to turn /admin off.
# ADMIN_PASSWORD=

# Optional abuse limits (defaults shown).
# REPORT_HIDE_THRESHOLD=3
# MAX_REPORTS_PER_IP_PER_HOUR=20
# MAX_PINS_PER_IP_PER_DAY=10
# MAX_COFFEE_PER_IP_PER_HOUR=150
